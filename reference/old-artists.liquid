      <!-- Guillermo Laporta -->
      <article class="ensemble-member">
        <div class="ensemble-member__media">
          <img src="https://creartbox-media-cdn.b-cdn.net/webimg/about-guillermo.png" alt="Guillermo Laporta, flute">
